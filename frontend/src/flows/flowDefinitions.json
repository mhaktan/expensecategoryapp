[
  {
    "id": "flow-ExpenseReport-approval",
    "name": "ExpenseReport Approval Flow",
    "description": "Auto-generated approval flow for ExpenseReport. Customize email templates and add conditions as needed.",
    "resourceName": "ExpenseReport",
    "enabled": true,
    "variables": [
      {
        "name": "assigneeEmail",
        "type": "string",
        "defaultValue": ""
      },
      {
        "name": "creatorEmail",
        "type": "string",
        "defaultValue": ""
      },
      {
        "name": "departmentEmails",
        "type": "string",
        "defaultValue": ""
      },
      {
        "name": "formLink",
        "type": "string",
        "defaultValue": ""
      }
    ],
    "nodes": [
      {
        "id": "ExpenseReport-approval-trigger",
        "type": "trigger",
        "label": "On ExpenseReport Submit",
        "position": {
          "x": 300,
          "y": 50
        },
        "trigger": {
          "type": "on-field-change",
          "resourceName": "ExpenseReport",
          "fieldName": "status"
        }
      },
      {
        "id": "ExpenseReport-approval-condition",
        "type": "condition",
        "label": "Status = PendingManagerApproval?",
        "position": {
          "x": 300,
          "y": 160
        },
        "condition": {
          "logic": "and",
          "rules": [
            {
              "field": "triggerData.status",
              "operator": "equals",
              "value": "1"
            }
          ]
        }
      },
      {
        "id": "ExpenseReport-approval-approval",
        "type": "approval",
        "label": "ExpenseReport Approval",
        "position": {
          "x": 300,
          "y": 280
        },
        "approval": {
          "steps": [
            {
              "name": "Yönetici Onayı",
              "assigneeType": "manager",
              "assigneeValue": "1",
              "actions": [
                {
                  "label": "Onayla",
                  "type": "approve"
                },
                {
                  "label": "Revize Et",
                  "type": "revise",
                  "requiredFields": [
                    "revisionNote"
                  ]
                }
              ]
            },
            {
              "name": "Finans Müdürü Onayı",
              "assigneeType": "role",
              "assigneeValue": "FinanceManager",
              "condition": {
                "logic": "and",
                "rules": [
                  {
                    "field": "totalAmount",
                    "value": "0",
                    "operator": "greater-than"
                  }
                ]
              },
              "actions": [
                {
                  "label": "Onayla",
                  "type": "approve"
                },
                {
                  "label": "Revize Et",
                  "type": "revise",
                  "requiredFields": [
                    "revisionNote"
                  ]
                }
              ]
            }
          ],
          "trackRevisionHistory": true,
          "onCompleteEvent": "ExpenseReport-approval-completed"
        }
      },
      {
        "id": "ExpenseReport-approval-email",
        "type": "action",
        "label": "Send Approval Email",
        "position": {
          "x": 300,
          "y": 400
        },
        "action": {
          "type": "send-email",
          "config": {
            "to": "{{assigneeEmail}}",
            "subject": "{{triggerData.title}} — Onayınızı bekliyor",
            "body": "<p>Sayın onaylayan,</p><p><strong>{{triggerData.title}}</strong> gider raporu onayınızı beklemektedir.</p>",
            "contentType": "html"
          }
        }
      },
      {
        "id": "ExpenseReport-approval-completion-trigger",
        "type": "trigger",
        "label": "On ExpenseReport Approved",
        "position": {
          "x": 700,
          "y": 50
        },
        "trigger": {
          "type": "manual",
          "resourceName": "ExpenseReport"
        }
      },
      {
        "id": "ExpenseReport-approval-completion-email",
        "type": "action",
        "label": "Send Completion Email",
        "position": {
          "x": 700,
          "y": 160
        },
        "action": {
          "type": "send-email",
          "config": {
            "to": "{{creatorEmail}}",
            "cc": "{{departmentEmails}}",
            "subject": "{{triggerData.formNo}} — Tum onaylar tamamlandi",
            "body": "<p>{{triggerData.formNo}} numarali formun onay sureci tamamlanmistir.</p>",
            "contentType": "html"
          }
        }
      }
    ],
    "edges": [
